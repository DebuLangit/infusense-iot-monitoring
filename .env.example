APP_PORT=3001

# Konfigurasi Database MySQL / MariaDB (Laragon / Linux)
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediflow_db

# Konfigurasi MQTT Broker
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_CLIENT_ID=mediflow-go-server
MQTT_TOPIC_PREFIX=mediflow

# Interval simpan log telemetri ke database (detik) agar DB tetap ringan
DB_SAVE_INTERVAL_SEC=15
